# ============================================================
# camera.ini — Pi Zero 2W Camera Configuration
# Lives in ~/camera_sender/sender/ alongside filesender.py
#
# THIS IS A TEMPLATE (camera.ini.example). Each camera keeps its own camera.ini,
# which updates never overwrite. Created automatically on first start — then set
# [camera] type and [server] camera_uuid for that camera.
# ============================================================

[camera]
# Camera type:
#   1 = Raspberry Pi camera (rpicam-vid / IMX708)
#   2 = USB webcam (v4l2)
#   3 = Imou Ranger S2 IP camera (RTSP + ONVIF)
type   = 1
width  = 1280
height = 720
fps    = 10

[raspicam]
# Settings for type = 1 (Raspberry Pi camera)
# width/height/fps taken from [camera] section
quality = 99

[webcam]
# Settings for type = 2 (USB webcam)
#device = /dev/video0
device = /dev/v4l/by-id/usb-046d_Brio_100_2523AP48RV78-video-index0
# Override resolution for webcam (Pi Zero USB bandwidth limit)
width  = 640
height = 480
fps    = 10

[imou]
# Settings for type = 3 (Imou Ranger S2)
rtsp_url = rtsp://admin:L21s12Q9@192.168.29.202:554/cam/realmonitor?channel=1&subtype=0
host     = 192.168.29.202
port     = 80
user     = admin
password = L21s12Q9

[ptz]
# enabled: 0 = no PTZ, 1 = PTZ present
enabled = 0
# type: onvif (Imou), servo (GPIO), none
type    = onvif

[audio]
# enabled: 0 = no audio, 1 = audio via RTSP stream
# Note: audio=1 requires camera type=3 (Imou RTSP)
# audio=0 uses /tmp/frames/ pipeline — no buffering issue
enabled = 0

[server]
ec2_url     = http://151.185.47.108:8000
camera_uuid = SET-THIS-CAMERA-UUID

[capture]
batch_frames   = 45
overlap_frames = 15
advance_frames = 30
keep_frames    = 200
queue_depth    = 3
upload_timeout = 25
mode_poll_sec  = 2
ptz_poll_sec   = 0.5

[wifi]
# Used by wifi_manager.py (Wi-Fi auto-connect + Bluetooth setup)
interface              = wlan0
# BLE name the app sees; {id} = last 4 characters of camera_uuid
ble_name               = MTCam-{id}
# Key the app must send with setup requests (from the QR sticker).
#   auto = random key generated once per camera (kept in /etc/wifi_manager)
#   show it + QR sticker:  ./start_pi.sh qr
setup_key              = auto
# Bluetooth when Wi-Fi is fine and nothing asked for it: off | on
bluetooth_default      = off
# Keep Bluetooth on this long after a successful setup, so the app gets the result
bt_off_after_setup_sec = 30
# Local control API (Bluetooth on/off, setup mode, status)
control_port           = 8085
# Seconds to wait at boot for a saved Wi-Fi before Bluetooth setup starts
boot_wait_sec          = 60
# Seconds Wi-Fi may stay down before saved networks are retried / setup starts
lost_grace_sec         = 120
# In setup mode (no phone connected), re-check saved networks this often
retry_known_sec        = 180
